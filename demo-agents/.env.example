# Core backend
BACKEND_URL=http://localhost:4000

# The x-agent-key shown ONCE when the agent was created with POST /agents
AGENT_KEY=

# Optional. If set, /quote /tasks /a2a require this value in the x-backend-secret header.
BACKEND_SECRET=

# NVIDIA (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Static Auditor
AUDITOR_PORT=5002
