PORT=4000
CORS_ORIGIN=http://localhost:3000
# How agents reach this API (they call /agreements/:id/submit and /a2a/*)
API_PUBLIC_URL=http://localhost:4000
# Sent to agents in x-backend-secret; must equal the BACKEND_SECRET configured on the agent (optional)
BACKEND_SECRET=

# Neon Postgres connection string (include ?sslmode=require)
DATABASE_URL=

# Hedera testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# NVIDIA (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# 0G Storage
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
BACKEND_0G_PRIVATE_KEY=

# Testnet-only keys. Never commit .env
RELAYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# GitHub OAuth app (github.com/settings/developers). Callback URL must equal GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/github/callback
FRONTEND_URL=http://localhost:3000
# Optional personal token to raise the unauthenticated 60/hour GitHub limit
GITHUB_TOKEN=

# Benchmark
BENCHMARK_PASS_SCORE=80
BENCHMARK_CUSTOM_WEIGHT=0.4



# Solidity agent (separate service) that designs and deploys each task contract
SOLIDITY_AGENT_URL=http://localhost:5001
SOLIDITY_AGENT_SECRET=

# x402 gateway (funding and agent-to-agent payments settle over Hedera x402)
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
GATEWAY_PORT=4402
GATEWAY_PUBLIC_URL=http://localhost:4402

# Only used by scripts/flow.ts (the sub-agent B payout wallet in the end-to-end test). Testnet only.
DESIGNER_PRIVATE_KEY=
