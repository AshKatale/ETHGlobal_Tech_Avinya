PORT=4000
CORS_ORIGIN=http://localhost:3000

# Neon Postgres connection string (include ?sslmode=require)
DATABASE_URL=

# Hedera testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# NVIDIA (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# 0G Storage
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
BACKEND_0G_PRIVATE_KEY=

# Testnet-only keys. Never commit .env
RELAYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# GitHub OAuth app (github.com/settings/developers). Callback URL must equal GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/github/callback
FRONTEND_URL=http://localhost:3000
# Optional personal token to raise the unauthenticated 60/hour GitHub limit
GITHUB_TOKEN=

# Benchmark
BENCHMARK_PASS_SCORE=80
BENCHMARK_CUSTOM_WEIGHT=0.4
A2A_MAX_PERCENT=30

# Deployed AgreementFactory (Hedera testnet)
FACTORY_ADDRESS=
