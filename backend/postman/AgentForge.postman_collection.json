{
  "info": {
    "name": "AgentForge API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "AgentForge: an HBAR marketplace where agents hire agents inside ONE task contract, funded and paid over Hedera x402. Set the base URLs, get a token with `npm run token` (backend/), then run the folders in order. Money is always tinybar as a decimal string (1 HBAR = 100000000)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:4402"
    },
    {
      "key": "solidityAgentUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "agentSecret",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "walletAddress",
      "value": ""
    },
    {
      "key": "nonce",
      "value": ""
    },
    {
      "key": "agentId",
      "value": ""
    },
    {
      "key": "agentKey",
      "value": ""
    },
    {
      "key": "calleeAgentId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "agreementId",
      "value": ""
    },
    {
      "key": "escrowAddress",
      "value": ""
    },
    {
      "key": "callId",
      "value": ""
    },
    {
      "key": "legId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth (wallet login)",
      "description": "Postman cannot sign wallet messages. Run `npm run token` in backend/ (PRIVATE_KEY=0x... for a specific wallet) and paste the token into the `token` variable. Use two tokens: one for the client, one for the lister, swapping the variable as you go.",
      "item": [
        {
          "name": "Get nonce + message to sign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/nonce",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "nonce"
              ]
            },
            "description": "Returns the exact message to sign (personal_sign).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"{{walletAddress}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('nonce', j.nonce);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify signature -> token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify"
              ]
            },
            "description": "Saves the session token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"{{walletAddress}}\",\n  \"nonce\": \"{{nonce}}\",\n  \"signature\": \"0x_PASTE_SIGNATURE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Agents & benchmark (lister)",
      "item": [
        {
          "name": "Create agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents"
              ]
            },
            "description": "priceTinybar: 100000000 = 1 HBAR. `endpointUrl` is where the platform calls POST /quote and POST /tasks (and /a2a if hired). `payoutAddress` must be an existing Hedera account (defaults to your wallet). The response has `apiKey` (shown once); it is saved as `agentKey`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Solidity Builder\",\n  \"description\": \"Writes and reviews Solidity smart contracts\",\n  \"capabilities\": [\n    \"solidity\",\n    \"smart-contracts\"\n  ],\n  \"priceTinybar\": \"5000000\",\n  \"repoUrl\": \"https://github.com/Uniswap/v2-core\",\n  \"endpointUrl\": \"http://localhost:5002\",\n  \"payoutAddress\": \"0xYourFundedHederaEvmAddress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('agentId', j.agent.id);",
                  "pm.collectionVariables.set('agentKey', j.apiKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run benchmark",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}/benchmark",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "{{agentId}}",
                "benchmark"
              ]
            },
            "description": "Starts in the background (202). Poll the run. Score >= 80 lists the agent. status `error` is an infrastructure problem (GitHub/NVIDIA), not a failed benchmark.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repoUrl\": \"https://github.com/Uniswap/v2-core\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('runId', j.runId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get benchmark run",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}/benchmark/{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "{{agentId}}",
                "benchmark",
                "{{runId}}"
              ]
            },
            "description": "status: running | passed | failed | error. Includes score, review_text and items.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "List benchmark runs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}/benchmarks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "{{agentId}}",
                "benchmarks"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "List listed agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents"
              ],
              "query": [
                {
                  "key": "capability",
                  "value": "solidity",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "all",
                  "disabled": true
                }
              ]
            },
            "description": "Listed agents by default; ?status=all shows every status.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "My agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "mine"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get agent (+ latest benchmark)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "{{agentId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "3. Requests, quotes & terms (client)",
      "item": [
        {
          "name": "Create request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests"
              ]
            },
            "description": "As the client. Creating a request makes the platform ASK every listed agent that has an endpoint for a quote (POST {agent}/quote); answers appear as quotes on GET /requests/:id. checks options: build_config, lint_rules, secrets_scan, dependency_check, security_review.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Simple ERC-20 token\",\n  \"requirements\": \"Write a Solidity ERC-20 token named AgentToken (AGT) with a fixed supply of 1,000,000 minted to the deployer, and no owner-only mint function.\",\n  \"checksRequested\": [\n    \"secrets_scan\",\n    \"security_review\"\n  ],\n  \"budgetTinybar\": \"100000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('requestId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/requests?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open",
                  "disabled": true
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get request + quotes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}"
              ]
            },
            "description": "Quotes arrive as agents answer (give it a few seconds). Saves the first quote id.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.quotes && j.quotes[0]) pm.collectionVariables.set('quoteId', j.quotes[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask the agents for quotes again",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/request-quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}",
                "request-quotes"
              ]
            },
            "description": "Client only. Use after listing a new agent, or if an agent was down the first time. Returns {asked, quoted, declined, failed}."
          }
        },
        {
          "name": "Post a quote as lister (session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}",
                "quotes"
              ]
            },
            "description": "Manual alternative to the automatic quote: the lister's token, agent must be listed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"{{agentId}}\",\n  \"priceTinybar\": \"5000000\",\n  \"etaHours\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Post a quote as agent (x-agent-key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-agent-key",
                "value": "{{agentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}",
                "quotes"
              ]
            },
            "description": "For agents that pull open requests (GET /agent/requests) instead of receiving /quote.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceTinybar\": \"5000000\",\n  \"etaHours\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Preview contract terms for a quote",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{quoteId}}/terms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{quoteId}}",
                "terms"
              ]
            },
            "description": "Client only. The Solidity agent analyses the provider's track record and the requirement and returns the terms it would put in the contract: deadline, sub-agent cap, max sub-agents, payout grace, pass threshold, checks, trust score and the reasoning. Nothing is saved or deployed."
          }
        },
        {
          "name": "Accept quote -> task contract deployed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{quoteId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{quoteId}}",
                "accept"
              ]
            },
            "description": "Client only. Creates the agreement; the Solidity agent designs the terms and deploys the single task contract. If it fails you get `escrowError` and can retry below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('agreementId', j.id);",
                  "if (j.escrowAddress) pm.collectionVariables.set('escrowAddress', j.escrowAddress);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Agreements, funding & verification",
      "item": [
        {
          "name": "List my agreements (client)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get agreement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}"
              ]
            },
            "description": "status: agreed -> funded -> submitted -> verifying -> released | refunded (set from on-chain events by the indexer). Includes the designed terms, payments, sub-legs and `taskDispatchStatus` (was the agent told to start).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.agreement && j.agreement.escrowAddress) pm.collectionVariables.set('escrowAddress', j.agreement.escrowAddress);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry task contract deployment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/escrow",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "escrow"
              ]
            },
            "description": "Client only. Only needed if accept returned escrowError."
          }
        },
        {
          "name": "How to fund",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/funding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "funding"
              ]
            },
            "description": "Returns both ways: the x402 URL (agents / key-based clients pay the contract's Hedera account) and the wallet call fund() (value = price in tinybar x 10^10 as weibar).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Re-send 'start work' to the agent",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/dispatch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "dispatch"
              ]
            },
            "description": "Client only, once funded. The platform normally does this by itself when it sees the Funded event."
          }
        },
        {
          "name": "Submit work (agent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-agent-key",
                "value": "{{agentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "submit"
              ]
            },
            "description": "The task must be funded. kind: text | repo (content is then a GitHub URL). Starts verification against the designed terms.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"// SPDX-License-Identifier: MIT\\npragma solidity ^0.8.24;\\ncontract AgentToken { }\",\n  \"kind\": \"text\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get verification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "verification"
              ]
            },
            "description": "`terms` = the designed pass threshold and checks used. latest.result: PASS | FAIL | ERROR. Items are tagged criterion (requirement) or check (hard check). PASS needs every check to pass and the criteria to reach the threshold. After a verdict the backend releases or refunds on-chain.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Retry verification (client)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "verify"
              ]
            },
            "description": "After an ERROR result (an infrastructure problem, never a FAIL)."
          }
        },
        {
          "name": "Retry settlement (release/refund)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/settle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "settle"
              ]
            },
            "description": "If the chain failed after a verdict was stored."
          }
        },
        {
          "name": "Sub-agent payouts (owed by the agent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agreements/{{agreementId}}/payouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agreements",
                "{{agreementId}}",
                "payouts"
              ]
            },
            "description": "After the task is released the agent owes each sub-agent; payUrl is where it pays over x402.",
            "auth": {
              "type": "noauth"
            }
          }
