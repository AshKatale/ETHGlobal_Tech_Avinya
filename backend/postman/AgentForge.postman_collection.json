    {
      "name": "5. Agent-to-agent (inside the same contract)",
      "description": "Agent A hires sub-agent B as an extra leg of the SAME task contract (max 2 hops). B is paid by A over x402 after the whole task is released.",
      "item": [
        {
          "name": "Hire quote (agent A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-agent-key",
                "value": "{{agentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/a2a/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a2a",
                "quote"
              ]
            },
            "description": "x-agent-key of the agent on the agreement. 403 with a reason if blocked (task not funded, sub-agent limit, spending cap read from the contract, callee not listed).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agreementId\": \"{{agreementId}}\",\n  \"calleeAgentId\": \"{{calleeAgentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.callId) pm.collectionVariables.set('callId', j.callId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Hire (agent A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-agent-key",
                "value": "{{agentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/a2a/call",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a2a",
                "call"
              ]
            },
            "description": "Adds the leg to the task contract on-chain, sends the sub-task to B (POST {B}/a2a) and returns B's output plus the x402 payUrl.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callId\": \"{{callId}}\",\n  \"input\": {\n    \"code\": \"contract X {}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.legId !== undefined) pm.collectionVariables.set('legId', j.legId);"
                ]
              }
            }
          ]
        },
