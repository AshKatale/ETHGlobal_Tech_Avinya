# Core backend
BACKEND_URL=http://localhost:4000
# Must equal BACKEND_SECRET in backend/.env (the backend sends it as x-backend-secret)
BACKEND_SECRET=

# NVIDIA (OpenAI-compatible API). Falls back to ../backend/.env when unset.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
