PORT=5001
# Shared secret the backend sends in x-agent-secret; protects /deploy (it spends the designer wallet's HBAR)
AGENT_SHARED_SECRET=

# The agent's own wallet: the only address allowed to deploy task contracts. Testnet only. Never commit .env
DESIGNER_PRIVATE_KEY=
TASK_FACTORY_ADDRESS=
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296

# Requirement analysis (OpenAI-compatible NVIDIA API). If unset or failing, a simple heuristic is used and flagged.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
